# Qwen on Alibaba Cloud DashScope (Model Studio) — REQUIRED for live runs.
# International (Singapore) endpoint; see README for region notes.
DASHSCOPE_API_KEY=sk-...

# Optional overrides
QUEN_DB_PATH=data/quen.db
QUEN_CHAT_MODEL=qwen3.5-plus
QUEN_FAST_MODEL=qwen-flash
QUEN_EMBED_MODEL=text-embedding-v4

# Set to 1 to run fully offline (deterministic hashing embedder + extractive
# answerer; no DashScope calls). Used by tests and CI.
QUEN_OFFLINE=0

# Repo path for the repo-grep verifier (verify-before-answer), if any.
QUEN_VERIFY_REPO=
